# Copy to .env and fill in. Never commit .env.

# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a redirect URI in your Spotify app settings exactly.
# Spotify only allows plain http for loopback IPs, so use 127.0.0.1, not localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# Generate both with: python -m echo keys
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# SQLite by default. For Postgres (docker compose up db):
# DATABASE_URL=postgresql+psycopg://echo:echo@127.0.0.1:5432/echo
DATABASE_URL=sqlite:///./echo.db

# Show generated demo listeners as sample matches to real users. Turn off before inviting real people.
SHOW_DEMO_USERS=true
# The "Try the demo" button: look around as a demo listener without logging in.
ALLOW_DEMO_LOGIN=true
# Create this many demo listeners at startup if they're missing (0 = off; or run: python -m echo seed-demo).
SEED_DEMO_LISTENERS=0

# Set to true when serving over https.
SECURE_COOKIES=false
